import pandas as pd
import matplotlib.pyplot as plt

# Step 1: Load the data
data = pd.read_csv('iris.csv')

# Step 2: Inspect the data to find the column with flower types
print(data.head())  # This will help us identify the correct column name for flower types

# Assuming the column name is 'species'. It usually contains the flower type in Iris dataset.
flower_counts = data['species'].value_counts()

# Step 3: Plot the graph
plt.figure(figsize=(8, 6))
flower_counts.plot(kind='bar', color=['#FF9999', '#66B3FF', '#99FF99'])
plt.title('Distribution of Flower Types in Iris Dataset')
plt.xlabel('Flower Types')
plt.ylabel('Count')
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

print("Graph of flower types has been plotted.")
